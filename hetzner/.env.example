# Im Verzeichnis hetzner als .env speichern. Keine URL und keinen Pfad angeben.
DTRACK_DOMAIN=dtrack.sogeo.services
# Vor dem Start durch eine erreichbare eigene E-Mail-Adresse ersetzen.
ACME_EMAIL=admin@example.com
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Stabil halten: Der Projektname bestimmt die Namen der persistenten Volumes.
COMPOSE_PROJECT_NAME=dependencytrack
TZ=Europe/Zurich

# Vollständige Releases; keine automatischen Dependency-Track-Major-Upgrades.
DTRACK_VERSION=5.2.1
CADDY_VERSION=2.11.7
POSTGRES_IMAGE=postgres:18-alpine

# Ausgangswerte für einen 4-GB-Host. Nach Host-Upgrade ebenfalls anpassen.
API_MEMORY_LIMIT=2g
POSTGRES_MEMORY_LIMIT=768m
FRONTEND_MEMORY_LIMIT=128m
CADDY_MEMORY_LIMIT=128m
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
