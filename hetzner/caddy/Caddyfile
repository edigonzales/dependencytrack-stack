{
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	# Nur TCP 80/443 veröffentlichen; kein zusätzlicher UDP-Port für HTTP/3.
	servers {
		protocols h1 h2
	}
}

{$DTRACK_DOMAIN} {
	encode zstd gzip
	header X-Content-Type-Options nosniff

	# handle erhält /api im Pfad. handle_path würde das API-Routing zerstören.
	@api path /api /api/*
	handle @api {
		reverse_proxy apiserver:8080
	}

	handle {
		reverse_proxy frontend:8080
	}

	# Keine Request-Header protokollieren: X-Api-Key und Login-Token sind geheim.
}
